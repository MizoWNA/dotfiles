{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#8a8a82",
            "output": "#f0efe8"
        },
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "kernel",
            "key": "KERNEL"
        },
        {
            "type": "uptime",
            "key": "UPTIME"
        },
        {
            "type": "packages",
            "key": "PACKAGES"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "terminal",
            "key": "TERM"
        },
        "break",
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "disk",
            "key": "DISK"
        }
    ]
}
