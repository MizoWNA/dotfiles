configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "APPS";
    display-run: "RUN";
    display-window: "WINDOWS";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    bg:        #0a0c0aee;
    bg-alt:    #16181699;
    fg:        #f0efe8ff;
    fg-muted:  #8a8a82ff;
    accent:    #e0602aff;
    border:    #ffffff14;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 1px solid;
    border-color: @border;
    border-radius: 10px;
    width: 640px;
    padding: 0px;
}

mainbox {
    background-color: transparent;
    padding: 18px;
    children: [ "inputbar", "listview" ];
    spacing: 14px;
}

inputbar {
    background-color: @bg-alt;
    border: 1px solid;
    border-color: @border;
    border-radius: 8px;
    padding: 10px 14px;
    children: [ "prompt", "entry" ];
    spacing: 10px;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "SEARCH";
    placeholder-color: @fg-muted;
    text-color: @fg;
}

listview {
    background-color: transparent;
    lines: 8;
    columns: 1;
    spacing: 2px;
    fixed-height: false;
    border: 0px;
}

element {
    padding: 8px 10px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg-muted;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent;
    border: 1px solid;
    border-color: @border;
}

element-icon {
    size: 22px;
    padding: 0px 10px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}
